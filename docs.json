{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Replayfy",
  "description": "Session replay, product analytics & error monitoring. Set up in under 2 minutes.",
  "colors": { "primary": "#6366F1", "light": "#818CF8", "dark": "#4F46E5" },
  "favicon": "/favicon.svg",
  "logo": { "light": "/logo/light.svg", "dark": "/logo/dark.svg" },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          { "group": "Get started", "pages": ["quickstart", "introduction"] },
          { "group": "SDKs", "pages": ["platforms/web", "platforms/ios", "platforms/android", "platforms/react-native", "platforms/flutter"] },
          { "group": "Guides", "pages": ["guides/identify-users", "guides/track-events", "guides/privacy-and-masking"] }
        ]
      }
    ]
  },
  "navbar": {
    "links": [{ "label": "Dashboard", "href": "https://app.replayfy.app" }],
    "primary": { "type": "button", "label": "Sign up free", "href": "https://app.replayfy.app/signup" }
  },
  "footer": {
    "socials": { "website": "https://replayfy.app", "github": "https://github.com/replayfy" }
  }
}
